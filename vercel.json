{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/velaris-design-system/ui_kits/web-app/home-figma", "destination": "/", "permanent": true },
    { "source": "/velaris-design-system/ui_kits/web-app/home-figma.html", "destination": "/", "permanent": true },
    { "source": "/velaris-design-system/ui_kits/web-app/home", "destination": "/", "permanent": true },
    { "source": "/velaris-design-system/ui_kits/web-app/home.html", "destination": "/", "permanent": true },
    { "source": "/velaris-design-system/ui_kits/web-app/index", "destination": "/", "permanent": true },
    { "source": "/velaris-design-system/ui_kits/web-app/index.html", "destination": "/", "permanent": true },
    {
      "source": "/post",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[A-Za-z0-9-]+)" }],
      "destination": "/blog/:slug",
      "permanent": true
    },
    { "source": "/post", "destination": "/blog", "permanent": true },
    {
      "source": "/velaris-design-system/ui_kits/web-app/post(\\.html)?",
      "has": [{ "type": "query", "key": "slug", "value": "(?<slug>[A-Za-z0-9-]+)" }],
      "destination": "/blog/:slug",
      "permanent": true
    },
    { "source": "/velaris-design-system/ui_kits/web-app/post(\\.html)?", "destination": "/blog", "permanent": true },
    {
      "source": "/work",
      "destination": "/case-studies",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/velaris-design-system/ui_kits/web-app/home-figma.html"
    },
    {
      "source": "/services",
      "destination": "/velaris-design-system/ui_kits/web-app/services"
    },
    {
      "source": "/service",
      "destination": "/velaris-design-system/ui_kits/web-app/service"
    },
    {
      "source": "/case-studies",
      "destination": "/velaris-design-system/ui_kits/web-app/work"
    },
    {
      "source": "/case",
      "destination": "/velaris-design-system/ui_kits/web-app/case"
    },
    {
      "source": "/pricing",
      "destination": "/velaris-design-system/ui_kits/web-app/pricing"
    },
    {
      "source": "/resources",
      "destination": "/velaris-design-system/ui_kits/web-app/resources"
    },
    {
      "source": "/blog",
      "destination": "/velaris-design-system/ui_kits/web-app/blog"
    },
    {
      "source": "/about",
      "destination": "/velaris-design-system/ui_kits/web-app/about"
    },
    {
      "source": "/playbook",
      "destination": "/velaris-design-system/ui_kits/web-app/playbook"
    }
  ]
}
